# ==============================================================================
# SQC - STATISTICAL QUALITY CONTROL SYSTEM CONFIGURATION
# Production Environment Configuration for Server: BJCL / Ubuntu
# ==============================================================================

PORT=3001
NODE_ENV=production

# Local PostgreSQL Connection for BJCL-SQC
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=SQC

LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=5432
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_NAME=SQC

# Legacy / Alternative DB env variables
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SQC

# API & Security Keys
API_KEY=change-this-to-a-long-secret-key-123456
JWT_SECRET=bjcl-sqc-jwt-secret-2026-quality-control

# Frontend API URL
VITE_API_URL=http://localhost:3001
VITE_API_KEY=change-this-to-a-long-secret-key-123456
