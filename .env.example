# ==============================================================================
# SQC - STATISTICAL QUALITY CONTROL SYSTEM CONFIGURATION
# Production Environment Configuration for Server: BJCL
# ==============================================================================

# Application Server Port
# Configured for Port 3001 for local network and static public IP port forwarding
PORT=3001

# PostgreSQL Database Configuration
# Host server name or IP (Server: BJCL)
DB_HOST=BJCL
DB_PORT=5432

# Target Database name (Notice: quoted in PostgreSQL because of space: "IT SQC")
DB_NAME=IT SQC

# PostgreSQL Credentials
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here

# API & Security Keys
API_KEY=change-this-to-a-long-secret-key-123456
JWT_SECRET=bjcl-sqc-jwt-secret-2026-quality-control

# Frontend API URL configuration
# For local network: http://192.168.1.XX:3001
# For static public IP: http://YOUR_STATIC_PUBLIC_IP:3001
VITE_API_URL=http://localhost:3001
VITE_API_KEY=change-this-to-a-long-secret-key-123456
